# Copy to .env.local and fill in. .env.local is gitignored; this file is not,
# so never put a real secret here. On Vercel these live in project settings,
# and `vercel env pull` writes them back into .env.local for you.
#
# Required to run: DATABASE_URL, DIRECT_URL, SESSION_SECRET.
# Everything else turns a feature on and is inert while unset.

# --- Database (Supabase) --- required
# Pooled connection, used by the app at runtime.
DATABASE_URL=postgresql://user:password@host:6543/postgres?pgbouncer=true
# Direct connection, used by prisma migrate. Migrations cannot run through
# the pooler.
DIRECT_URL=postgresql://user:password@host:5432/postgres
# Reserved, not yet read by anything: Prisma connects over DATABASE_URL, so
# no code path consumes this today. Kept for a future direct Supabase call.
# Server-side only if it ever is used -- never expose it to the browser
# (CLAUDE.md rule 7).
SUPABASE_SERVICE_KEY=

# --- Sessions --- required
# Signs both session cookies. Any long random string; generate one with
# `openssl rand -base64 32`. Changing it invalidates every existing session.
SESSION_SECRET=

# --- Password reset email --- required for /forgot, ignored otherwise
# "console" prints reset links to the server log and sends nothing -- the
# default for local development, and refused in production. "resend" sends
# real mail and requires the two variables below.
MAILER=console

# Origin only: scheme + host, no trailing slash, no path. Reset links are
# built from this and never from the request Host header, which is
# attacker-controlled (CLAUDE.md rule 12). Unset, the forgot endpoint throws
# rather than falling back.
APP_URL=http://localhost:3000

# Only needed when MAILER=resend.
RESEND_API_KEY=
# Must be an address at a domain verified in Resend. A display name is
# optional: `FairShareTab <noreply@yourdomain.com>`.
EMAIL_FROM=noreply@yourdomain.com

# --- Receipt storage (Vercel Blob) --- optional
# Read from the environment by the @vercel/blob SDK itself -- no code in this
# repo mentions it, which is exactly why it is easy to miss. Without it,
# receipt uploads fail and nothing else changes: no part of the money path
# depends on Blob being reachable (CLAUDE.md rule 13).
BLOB_READ_WRITE_TOKEN=
