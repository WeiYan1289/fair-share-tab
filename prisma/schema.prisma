// Source of truth: docs/data-model.md. Keep this file and that document in sync.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ShareLinkRole {
  editor
  viewer
}

enum EventStatus {
  active
  archived
}

enum SplitMethod {
  equal
  custom
}

enum BillStatus {
  unsettled
  settled
}

enum SettlementStatus {
  draft
  confirmed
}

model Group {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  shareLinks  GroupShareLink[]
  members     Member[]
  events      Event[]
  memberships GroupMembership[]

  @@map("group")
}

model GroupShareLink {
  id        String        @id @default(uuid()) @db.Uuid
  groupId   String        @map("group_id") @db.Uuid
  token     String        @unique
  role      ShareLinkRole
  revokedAt DateTime?     @map("revoked_at")
  createdAt DateTime      @default(now()) @map("created_at")

  group Group @relation(fields: [groupId], references: [id], onDelete: Restrict)

  @@map("group_share_link")
}

model Member {
  id          String   @id @default(uuid()) @db.Uuid
  groupId     String   @map("group_id") @db.Uuid
  userId      String?  @map("user_id") @db.Uuid
  name        String
  email       String?
  isActive    Boolean  @default(true) @map("is_active")
  avatarColor String   @map("avatar_color")
  createdAt   DateTime @default(now()) @map("created_at")

  group        Group         @relation(fields: [groupId], references: [id], onDelete: Restrict)
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  eventMembers EventMember[]
  billsPaid    Bill[]        @relation("BillPayer")
  splits       Split[]
  transfersOut Transfer[]    @relation("TransferFrom")
  transfersIn  Transfer[]    @relation("TransferTo")

  @@index([groupId])
  @@index([groupId, isActive])
  @@index([userId])
  @@map("member")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Null means "password never changed since registration". Set on every
  // password change so an already-issued session cookie can be recognised
  // as stale and rejected -- without this, resetting a password would not
  // evict a session an attacker already holds (see the password-reset
  // design, "Session invalidation").
  passwordChangedAt DateTime? @map("password_changed_at")

  members             Member[]
  memberships         GroupMembership[]
  passwordResetTokens PasswordResetToken[]

  @@map("user")
}

// A single-use credential for account recovery. Unlike GroupShareLink --
// which stores its token raw because a share link is a capability meant to
// be held by many people -- this token is stored only as a SHA-256 hash,
// so a leak of this table cannot be replayed against pending resets.
// SHA-256 rather than Argon2id because the lookup is BY token, which needs
// a deterministic, indexable hash; the token's ~190 bits of entropy are
// what make a fast hash safe here.
model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Not decorative: this is the index the per-account cooldown and daily
  // cap read on every forgot-password request.
  @@index([userId, createdAt])
  @@map("password_reset_token")
}

// Grants a registered user standing access to a group, parallel to (and
// independent of) the anonymous GroupShareLink model — see data-model.md §9.
// role reuses ShareLinkRole for symmetry with share links; v1 only ever
// creates "editor" memberships (a group's registered creator/owner). The
// field exists so a future co-owner-invite feature doesn't need a schema
// change, not because anything in v1 creates a "viewer" membership.
model GroupMembership {
  id        String        @id @default(uuid()) @db.Uuid
  groupId   String        @map("group_id") @db.Uuid
  userId    String        @map("user_id") @db.Uuid
  role      ShareLinkRole
  createdAt DateTime      @default(now()) @map("created_at")

  group Group @relation(fields: [groupId], references: [id], onDelete: Restrict)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
  @@index([groupId])
  @@map("group_membership")
}

model Event {
  id        String      @id @default(uuid()) @db.Uuid
  groupId   String      @map("group_id") @db.Uuid
  name      String
  currency  String      @default("MYR") @db.VarChar(3)
  startDate DateTime?   @map("start_date") @db.Date
  endDate   DateTime?   @map("end_date") @db.Date
  status    EventStatus @default(active)
  createdAt DateTime    @default(now()) @map("created_at")

  group        Group         @relation(fields: [groupId], references: [id], onDelete: Restrict)
  eventMembers EventMember[]
  bills        Bill[]
  settlements  Settlement[]

  @@index([groupId])
  @@index([groupId, status])
  @@map("event")
}

model EventMember {
  eventId  String @map("event_id") @db.Uuid
  memberId String @map("member_id") @db.Uuid

  event  Event  @relation(fields: [eventId], references: [id], onDelete: Restrict)
  member Member @relation(fields: [memberId], references: [id], onDelete: Restrict)

  @@id([eventId, memberId])
  @@index([memberId])
  @@map("event_member")
}

model Bill {
  id          String      @id @default(uuid()) @db.Uuid
  eventId     String      @map("event_id") @db.Uuid
  payerId     String      @map("payer_id") @db.Uuid
  title       String
  totalAmount Int         @map("total_amount")
  splitMethod SplitMethod @map("split_method")
  status      BillStatus  @default(unsettled)
  category    String?
  note        String?
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  event           Event            @relation(fields: [eventId], references: [id], onDelete: Restrict)
  payer           Member           @relation("BillPayer", fields: [payerId], references: [id], onDelete: Restrict)
  splits          Split[]
  settlementBills SettlementBill[]

  @@index([eventId])
  @@index([eventId, status])
  @@map("bill")
}

model Split {
  id          String @id @default(uuid()) @db.Uuid
  billId      String @map("bill_id") @db.Uuid
  memberId    String @map("member_id") @db.Uuid
  shareAmount Int    @map("share_amount")

  bill   Bill   @relation(fields: [billId], references: [id], onDelete: Cascade)
  member Member @relation(fields: [memberId], references: [id], onDelete: Restrict)

  @@unique([billId, memberId])
  @@index([memberId])
  @@map("split")
}

model Settlement {
  id        String           @id @default(uuid()) @db.Uuid
  eventId   String           @map("event_id") @db.Uuid
  status    SettlementStatus @default(draft)
  createdAt DateTime         @default(now()) @map("created_at")

  event           Event            @relation(fields: [eventId], references: [id], onDelete: Restrict)
  settlementBills SettlementBill[]
  transfers       Transfer[]

  @@map("settlement")
}

model SettlementBill {
  settlementId String @map("settlement_id") @db.Uuid
  billId       String @map("bill_id") @db.Uuid

  settlement Settlement @relation(fields: [settlementId], references: [id], onDelete: Restrict)
  bill       Bill       @relation(fields: [billId], references: [id], onDelete: Restrict)

  @@id([settlementId, billId])
  @@index([billId])
  @@map("settlement_bill")
}

model Transfer {
  id           String @id @default(uuid()) @db.Uuid
  settlementId String @map("settlement_id") @db.Uuid
  fromMemberId String @map("from_member_id") @db.Uuid
  toMemberId   String @map("to_member_id") @db.Uuid
  amount       Int

  settlement Settlement @relation(fields: [settlementId], references: [id], onDelete: Restrict)
  fromMember Member     @relation("TransferFrom", fields: [fromMemberId], references: [id], onDelete: Restrict)
  toMember   Member     @relation("TransferTo", fields: [toMemberId], references: [id], onDelete: Restrict)

  @@index([settlementId])
  @@map("transfer")
}
