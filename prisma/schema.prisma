// Source of truth: docs/data-model.md. Keep this file and that document in sync.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ShareLinkRole {
  editor
  viewer
}

enum EventStatus {
  active
  archived
}

enum SplitMethod {
  equal
  custom
}

enum BillStatus {
  unsettled
  settled
}

enum SettlementStatus {
  draft
  confirmed
}

model Group {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  shareLinks GroupShareLink[]
  members    Member[]
  events     Event[]

  @@map("group")
}

model GroupShareLink {
  id        String        @id @default(uuid()) @db.Uuid
  groupId   String        @map("group_id") @db.Uuid
  token     String        @unique
  role      ShareLinkRole
  revokedAt DateTime?     @map("revoked_at")
  createdAt DateTime      @default(now()) @map("created_at")

  group Group @relation(fields: [groupId], references: [id], onDelete: Restrict)

  @@map("group_share_link")
}

model Member {
  id          String   @id @default(uuid()) @db.Uuid
  groupId     String   @map("group_id") @db.Uuid
  userId      String?  @map("user_id") @db.Uuid
  name        String
  email       String?
  isActive    Boolean  @default(true) @map("is_active")
  avatarColor String   @map("avatar_color")
  createdAt   DateTime @default(now()) @map("created_at")

  group        Group          @relation(fields: [groupId], references: [id], onDelete: Restrict)
  eventMembers EventMember[]
  billsPaid    Bill[]         @relation("BillPayer")
  splits       Split[]
  transfersOut Transfer[]     @relation("TransferFrom")
  transfersIn  Transfer[]     @relation("TransferTo")

  @@index([groupId])
  @@index([groupId, isActive])
  @@map("member")
}

model Event {
  id        String      @id @default(uuid()) @db.Uuid
  groupId   String      @map("group_id") @db.Uuid
  name      String
  currency  String      @default("MYR") @db.VarChar(3)
  startDate DateTime?   @map("start_date") @db.Date
  endDate   DateTime?   @map("end_date") @db.Date
  status    EventStatus @default(active)
  createdAt DateTime    @default(now()) @map("created_at")

  group        Group         @relation(fields: [groupId], references: [id], onDelete: Restrict)
  eventMembers EventMember[]
  bills        Bill[]
  settlements  Settlement[]

  @@index([groupId])
  @@index([groupId, status])
  @@map("event")
}

model EventMember {
  eventId  String @map("event_id") @db.Uuid
  memberId String @map("member_id") @db.Uuid

  event  Event  @relation(fields: [eventId], references: [id], onDelete: Restrict)
  member Member @relation(fields: [memberId], references: [id], onDelete: Restrict)

  @@id([eventId, memberId])
  @@index([memberId])
  @@map("event_member")
}

model Bill {
  id          String      @id @default(uuid()) @db.Uuid
  eventId     String      @map("event_id") @db.Uuid
  payerId     String      @map("payer_id") @db.Uuid
  title       String
  totalAmount Int         @map("total_amount")
  splitMethod SplitMethod @map("split_method")
  status      BillStatus  @default(unsettled)
  category    String?
  note        String?
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  event           Event            @relation(fields: [eventId], references: [id], onDelete: Restrict)
  payer           Member           @relation("BillPayer", fields: [payerId], references: [id], onDelete: Restrict)
  splits          Split[]
  settlementBills SettlementBill[]

  @@index([eventId])
  @@index([eventId, status])
  @@map("bill")
}

model Split {
  id          String @id @default(uuid()) @db.Uuid
  billId      String @map("bill_id") @db.Uuid
  memberId    String @map("member_id") @db.Uuid
  shareAmount Int    @map("share_amount")

  bill   Bill   @relation(fields: [billId], references: [id], onDelete: Cascade)
  member Member @relation(fields: [memberId], references: [id], onDelete: Restrict)

  @@unique([billId, memberId])
  @@index([memberId])
  @@map("split")
}

model Settlement {
  id        String           @id @default(uuid()) @db.Uuid
  eventId   String           @map("event_id") @db.Uuid
  status    SettlementStatus @default(draft)
  createdAt DateTime         @default(now()) @map("created_at")

  event           Event            @relation(fields: [eventId], references: [id], onDelete: Restrict)
  settlementBills SettlementBill[]
  transfers       Transfer[]

  @@map("settlement")
}

model SettlementBill {
  settlementId String @map("settlement_id") @db.Uuid
  billId       String @map("bill_id") @db.Uuid

  settlement Settlement @relation(fields: [settlementId], references: [id], onDelete: Restrict)
  bill       Bill       @relation(fields: [billId], references: [id], onDelete: Restrict)

  @@id([settlementId, billId])
  @@index([billId])
  @@map("settlement_bill")
}

model Transfer {
  id           String @id @default(uuid()) @db.Uuid
  settlementId String @map("settlement_id") @db.Uuid
  fromMemberId String @map("from_member_id") @db.Uuid
  toMemberId   String @map("to_member_id") @db.Uuid
  amount       Int

  settlement Settlement @relation(fields: [settlementId], references: [id], onDelete: Restrict)
  fromMember Member     @relation("TransferFrom", fields: [fromMemberId], references: [id], onDelete: Restrict)
  toMember   Member     @relation("TransferTo", fields: [toMemberId], references: [id], onDelete: Restrict)

  @@index([settlementId])
  @@map("transfer")
}
