# Copy to .env.local and fill in. .env.local is gitignored; this file is not,
# so never put a real secret here.

# --- Database (Supabase) ---
# Pooled connection, used by the app at runtime.
DATABASE_URL=postgresql://user:password@host:6543/postgres?pgbouncer=true
# Direct connection, used by prisma migrate. Migrations cannot run through
# the pooler.
DIRECT_URL=postgresql://user:password@host:5432/postgres
# Server-side only. Never expose to the browser (CLAUDE.md rule 7).
SUPABASE_SERVICE_KEY=

# --- Sessions ---
# Signs both session cookies. Any long random string; generate one with
# `openssl rand -base64 32`. Changing it invalidates every existing session.
SESSION_SECRET=

# --- Password reset email ---
# "console" prints reset links to the server log and sends nothing -- the
# default for local development, and refused in production. "resend" sends
# real mail and requires the two variables below.
MAILER=console

# Origin only: scheme + host, no trailing slash, no path. Reset links are
# built from this and never from the request Host header, which is
# attacker-controlled (CLAUDE.md rule 11). Unset, the forgot endpoint throws.
APP_URL=http://localhost:3000

# Only needed when MAILER=resend.
RESEND_API_KEY=
# Must be an address at a domain verified in Resend. A display name is
# optional: `FairShareTab <noreply@yourdomain.com>`.
EMAIL_FROM=noreply@yourdomain.com
